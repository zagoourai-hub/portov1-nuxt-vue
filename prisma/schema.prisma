generator client {
  provider            = "prisma-client"
  output              = "../server/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum MediaState {
  UPLOADING
  READY
  FAILED
  DELETING
}

enum MediaKind {
  IMAGE
  PDF
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id @default(uuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model Profile {
  id           String               @id @default(uuid())
  singletonKey String               @unique @default("main")
  name         String               @default("")
  email        String               @default("")
  linkedinUrl  String               @default("")
  photoId      String?
  photo        Media?               @relation(fields: [photoId], references: [id], onDelete: Restrict)
  status       ContentStatus        @default(DRAFT)
  version      Int                  @default(1)
  translations ProfileTranslation[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([photoId])
}

model ProfileTranslation {
  profileId String
  locale    String
  role      String  @default("")
  summary   String  @default("")
  photoAlt  String  @default("")
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, locale])
}

model Project {
  id               String               @id @default(uuid())
  slug             String               @unique
  status           ContentStatus        @default(DRAFT)
  demoUrl          String?
  repositoryUrl    String?
  technologies     Json                 @default("[]")
  position         Int                  @default(0)
  featured         Boolean              @default(false)
  firstPublishedAt DateTime?
  version          Int                  @default(1)
  translations     ProjectTranslation[]
  images           ProjectImage[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, position, id])
}

model ProjectTranslation {
  projectId String
  locale    String
  title     String  @default("")
  summary   String  @default("")
  role      String  @default("")
  outcome   String  @default("")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, locale])
}

model ProjectImage {
  id        String  @id @default(uuid())
  projectId String
  mediaId   String
  position  Int     @default(0)
  altId     String  @default("")
  altEn     String  @default("")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([projectId, position])
  @@index([mediaId])
}

model Experience {
  id           String                  @id @default(uuid())
  company      String                  @default("")
  startDate    DateTime
  endDate      DateTime?
  position     Int                     @default(0)
  status       ContentStatus           @default(DRAFT)
  version      Int                     @default(1)
  translations ExperienceTranslation[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([status, position, id])
}

model ExperienceTranslation {
  experienceId String
  locale       String
  role         String     @default("")
  description  String     @default("")
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@id([experienceId, locale])
}

model Skill {
  id        String   @id @default(uuid())
  name      String
  position  Int      @default(0)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position, id])
}

model Resume {
  id           String              @id @default(uuid())
  singletonKey String              @unique @default("main")
  status       ContentStatus       @default(DRAFT)
  version      Int                 @default(1)
  translations ResumeTranslation[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model ResumeTranslation {
  resumeId String
  locale   String
  mediaId  String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  media    Media  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@id([resumeId, locale])
  @@index([mediaId])
}

model Media {
  id        String              @id @default(uuid())
  objectKey String              @unique
  kind      MediaKind
  mimeType  String
  byteSize  Int
  state     MediaState          @default(UPLOADING)
  createdAt DateTime            @default(now())
  profiles  Profile[]
  images    ProjectImage[]
  resumes   ResumeTranslation[]
}

model RequestLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime
}
