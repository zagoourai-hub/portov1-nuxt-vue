[{"filePath":"D:\\Project\\project\\Web\\Portfolio\\Nuxt js\\portfolio-1\\app\\components\\PortfolioHeader.vue","messages":[{"ruleId":"better-tailwindcss/no-unknown-classes","severity":2,"message":"Unknown class detected: site-header","line":27,"column":18,"endLine":27,"endColumn":29},{"ruleId":"better-tailwindcss/no-unknown-classes","severity":2,"message":"Unknown class detected: header-inner","line":28,"column":17,"endLine":28,"endColumn":29},{"ruleId":"better-tailwindcss/no-unknown-classes","severity":2,"message":"Unknown class detected: page-width","line":28,"column":30,"endLine":28,"endColumn":40},{"ruleId":"better-tailwindcss/no-unknown-classes","severity":2,"message":"Unknown class detected: brand","line":31,"column":16,"endLine":31,"endColumn":21},{"ruleId":"better-tailwindcss/no-unknown-classes","severity":2,"message":"Unknown class detected: brand-dot","line":35,"column":36,"endLine":35,"endColumn":45},{"ruleId":"better-tailwindcss/no-unknown-classes","severity":2,"message":"Unknown class detected: desktop-nav","line":38,"column":16,"endLine":38,"endColumn":27},{"ruleId":"better-tailwindcss/no-unknown-classes","severity":2,"message":"Unknown class detected: header-actions","line":51,"column":19,"endLine":51,"endColumn":33},{"ruleId":"better-tailwindcss/no-unknown-classes","severity":2,"message":"Unknown class detected: locale-switch","line":53,"column":18,"endLine":53,"endColumn":31},{"ruleId":"better-tailwindcss/no-unknown-classes","severity":2,"message":"Unknown class detected: header-cv","line":71,"column":18,"endLine":71,"endColumn":27},{"ruleId":"better-tailwindcss/no-unknown-classes","severity":2,"message":"Unknown class detected: menu-toggle","line":81,"column":18,"endLine":81,"endColumn":29},{"ruleId":"better-tailwindcss/no-unknown-classes","severity":2,"message":"Unknown class detected: mobile-nav","line":93,"column":14,"endLine":93,"endColumn":24},{"ruleId":"better-tailwindcss/no-unknown-classes","severity":2,"message":"Unknown class detected: cv-notice","line":114,"column":14,"endLine":114,"endColumn":23},{"ruleId":"better-tailwindcss/no-unknown-classes","severity":2,"message":"Unknown class detected: page-width","line":114,"column":24,"endLine":114,"endColumn":34}],"suppressedMessages":[],"errorCount":13,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"<script setup lang=\"ts\">\nconst { locale, text, localePath } = usePortfolioLocale()\nconst route = useRoute()\nconst isMenuOpen = ref(false)\nconst isCvNoticeOpen = ref(false)\nconst links = computed(() => [\n  { label: text.value.home, to: '/' + locale.value, section: '' },\n  { label: text.value.about, to: '/' + locale.value + '#about', section: '#about' },\n  { label: text.value.projects, to: '/' + locale.value + '/projects', section: 'projects' },\n  { label: text.value.experience, to: '/' + locale.value + '#experience', section: '#experience' },\n  { label: text.value.contact, to: '/' + locale.value + '#contact', section: '#contact' }\n])\n\nfunction isActive(section: string) {\n  if (section === 'projects') return route.path.includes('/projects')\n  if (section) return route.hash === section\n  return !route.path.includes('/projects') && !route.hash\n}\n\nwatch(() => route.fullPath, () => {\n  isMenuOpen.value = false\n  isCvNoticeOpen.value = false\n})\n</script>\n\n<template>\n  <header class=\"site-header\">\n    <div class=\"header-inner page-width\">\n      <NuxtLink\n        :to=\"'/' + locale\"\n        class=\"brand\"\n        aria-label=\"Portfolio\"\n      >\n        <UIcon name=\"i-lucide-code-xml\" />\n        <span>YourName<span class=\"brand-dot\">.</span></span>\n      </NuxtLink>\n      <nav\n        class=\"desktop-nav\"\n        :aria-label=\"text.navigation\"\n      >\n        <NuxtLink\n          v-for=\"link in links\"\n          :key=\"link.label\"\n          :to=\"link.to\"\n          :class=\"{ active: isActive(link.section) }\"\n          :aria-current=\"isActive(link.section) ? 'page' : undefined\"\n        >\n          {{ link.label }}\n        </NuxtLink>\n      </nav>\n      <div class=\"header-actions\">\n        <div\n          class=\"locale-switch\"\n          aria-label=\"Language\"\n        >\n          <NuxtLink\n            v-for=\"language in (['id', 'en'] as const)\"\n            :key=\"language\"\n            :to=\"localePath(language)\"\n            :class=\"{ selected: locale === language }\"\n            :aria-current=\"locale === language ? 'true' : undefined\"\n            :aria-label=\"language === 'id' ? 'Bahasa Indonesia' : 'English'\"\n            :lang=\"language\"\n          >\n            {{ language.toUpperCase() }}\n          </NuxtLink>\n        </div>\n        <UButton\n          color=\"neutral\"\n          variant=\"outline\"\n          class=\"header-cv\"\n          trailing-icon=\"i-lucide-download\"\n          :aria-expanded=\"isCvNoticeOpen\"\n          @click=\"isCvNoticeOpen = !isCvNoticeOpen\"\n        >\n          {{ text.cv }}\n        </UButton>\n        <UButton\n          color=\"neutral\"\n          variant=\"ghost\"\n          class=\"menu-toggle\"\n          :icon=\"isMenuOpen ? 'i-lucide-x' : 'i-lucide-menu'\"\n          :aria-label=\"isMenuOpen ? text.closeMenu : text.openMenu\"\n          :aria-expanded=\"isMenuOpen\"\n          aria-controls=\"mobile-navigation\"\n          @click=\"isMenuOpen = !isMenuOpen\"\n        />\n      </div>\n    </div>\n    <nav\n      v-if=\"isMenuOpen\"\n      id=\"mobile-navigation\"\n      class=\"mobile-nav\"\n      :aria-label=\"text.navigation\"\n      @keydown.esc=\"isMenuOpen = false\"\n    >\n      <NuxtLink\n        v-for=\"link in links\"\n        :key=\"link.label\"\n        :to=\"link.to\"\n        :class=\"{ active: isActive(link.section) }\"\n      >{{ link.label }}</NuxtLink>\n      <UButton\n        variant=\"outline\"\n        color=\"neutral\"\n        trailing-icon=\"i-lucide-download\"\n        @click=\"isCvNoticeOpen = !isCvNoticeOpen\"\n      >\n        {{ text.cv }}\n      </UButton>\n    </nav>\n    <div\n      v-if=\"isCvNoticeOpen\"\n      class=\"cv-notice page-width\"\n      role=\"status\"\n    >\n      <UIcon name=\"i-lucide-info\" />\n      <p>{{ text.cvUnavailable }}</p>\n      <UButton\n        icon=\"i-lucide-x\"\n        color=\"neutral\"\n        variant=\"ghost\"\n        :aria-label=\"locale === 'id' ? 'Tutup' : 'Close'\"\n        @click=\"isCvNoticeOpen = false\"\n      />\n    </div>\n  </header>\n</template>\n","usedDeprecatedRules":[]}]